# Copy this file to .env and fill in your key.
# Free key, no credit card: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional overrides (any OpenAI-compatible endpoint works)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# LLM_FALLBACK_MODEL=openrouter/free

# Set to 1 to run without any API key (rule-based demo brain, no LLM calls)
# LLM_MOCK=1

# Per-visitor limits that protect the free API quota (~50 requests/day per key)
# RATE_LIMIT_PER_MINUTE=6
# RATE_LIMIT_PER_DAY=25
