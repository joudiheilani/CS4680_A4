# Copy this file to .env and fill in your key.
# Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (any OpenAI-compatible endpoint works, e.g. OpenRouter)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# Set to 1 to run without any API key (rule-based demo brain, no LLM calls)
# LLM_MOCK=1

# Per-visitor limits that protect the free API quota
# RATE_LIMIT_PER_MINUTE=6
# RATE_LIMIT_PER_DAY=120
